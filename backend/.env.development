# ==================================================
# Application
# ==================================================

APP_NAME=AI Studio
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

API_PREFIX=/api/v1

# ==================================================
# Security
# ==================================================

SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================================================
# MongoDB
# ==================================================

MONGODB_URI=mongodb+srv://nxzenai_admin:nxzenai@cluster0.p6h7hjw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

DATABASE_NAME=ai_studio

# ==================================================
# MinIO
# ==================================================

MINIO_ENDPOINT=localhost:9000

MINIO_ACCESS_KEY=minioadmin

MINIO_SECRET_KEY=minioadmin

MINIO_BUCKET=ai-studio

MINIO_SECURE=False

# ==================================================
# Docker Runner
# ==================================================

DOCKER_NETWORK=bridge

PYTHON_RUNNER_IMAGE=python:3.12-slim

NOTEBOOK_RUNNER_IMAGE=jupyter/base-notebook

# ==================================================
# Frontend
# ==================================================

FRONTEND_URL=http://localhost:3000

# ==================================================
# Logging
# ==================================================

LOG_LEVEL=INFO

# ==================================================
# JWT
# ==================================================

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

REFRESH_TOKEN_EXPIRE_DAYS=7